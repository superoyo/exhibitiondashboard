# ===== apps/web — build-time public config =====
# Everything here ships to the browser. NEVER put a secret in this file.

# API base. Empty = same origin (production, and dev via the Vite proxy).
VITE_API_BASE_URL=

# Google Analytics measurement id. Unset disables analytics entirely.
VITE_GA_ID=G-LR32XF3T80

# Shared "Global Menu" widget injected into the navbar by the host app.
VITE_GLOBAL_MENU_URL=https://agencyitelligence-production.up.railway.app/global-menu.js

# Dev only: where `vite dev` proxies /api and /static.
VITE_PROXY_TARGET=http://localhost:8000
