# ===== apps/api — Express backend =====
# Real secrets live in Railway → Variables. Never commit a filled-in .env.

# Postgres. Railway injects this from the Postgres plugin.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kol

PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# Identity backend (Wazzup / Fareast Fameline).
WAZZUP_BASE_URL=https://api.fareastfamelineddb.com

# Secret for triggering the daily scrape by hand (header X-ADMIN-KEY).
ADMIN_KEY=change-me-to-a-long-random-string

# Apify token. A DB override set from the /token page wins over this.
APIFY_TOKEN=

# ---- migration scaffolding -------------------------------------------------
# Anything Express has not ported yet is proxied to the Python app. Unset this
# once every endpoint is native and the sidecar only handles PPTX + tie-in.
PYTHON_SERVICE_URL=http://127.0.0.1:8000

# Where the built React SPA lives, relative to the repo root.
WEB_DIST_DIR=apps/web/dist
